# --- 1. HAUPTDOMAIN (Django & Frontend) ---
aetherus.net {
    # Pfad für Django-statische Dateien (z.B. Admin-CSS)
    # Erwartet Dateien in: ./backend/staticfiles
    handle_path /static/* {
        root * /app/staticfiles
        file_server
    }

    # Root-Verzeichnis für deine Frontend-Dateien (login.js, style.css, etc.)
    # Erwartet Dateien in: ./main/frontend
    root * /usr/share/caddy/html
    file_server

    # Spezial-Handling für das Dashboard (verhindert .html Loops)
    handle /main {
        reverse_proxy login-backend:8000
    }

    # Backend-Routen für Django
    @django_backend path /api/* /admin/* /login /register /
    handle @django_backend {
        reverse_proxy login-backend:8000
    }

    # Fallback: Versuche die Datei direkt zu finden, sonst mit .html, sonst start.html
    try_files {path} {path}.html /start.html
}

# --- 2. MAILCOW (Subdomain) ---
mail.aetherus.net {
    reverse_proxy 172.30.1.1:8080 {
        # Wichtig für Mailcow (SOGo) Websockets & ActiveSync
        header_up Upgrade {http.request.header.Upgrade}
        header_up Connection {http.request.header.Connection}
    }
}

# --- 3. WWW REDIRECT ---
www.aetherus.net {
    redir https://aetherus.net{uri}
}