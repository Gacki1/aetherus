# --- 1. HAUPTDOMAIN (Django & Frontend) ---
aetherus.net, www.aetherus.net {

    root * /usr/share/caddy/html
    

    handle_path /static/* {
        root * /app/staticfiles
        file_server
    }
    

    @backend path /api/* /admin/* /login /register /main /
    reverse_proxy @backend login-backend:8000


    try_files {path} {path}.html /index.html 
    file_server 
}

# --- 2. MAILCOW (Subdomain) ---
mail.aetherus.net {
    reverse_proxy 172.30.1.11:8080 {
        header_up Host {host}
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-For {remote_host} 
        header_up X-Forwarded-Host {host}
    }
}