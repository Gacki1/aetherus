{
    # Globale Optionen (optional, hilft bei Debugging)
    email dein-email@aetherus.net
}

# --- 1. HAUPTDOMAIN (Django & Frontend) ---
aetherus.net {
    # 1. Django Static (Admin-Panel etc.)
    handle_path /static/* {
        root * /app/staticfiles
        file_server
    }

    # 2. Deine Frontend-Dateien (login.js, style.css, etc.)
    # Wir sagen Caddy: Wenn eine Datei im Root / nicht gefunden wird, 
    # schau direkt im html-Ordner nach.
    root * /usr/share/caddy/html

    # Erlaubt den direkten Zugriff auf .js und .css Dateien im Root
    file_server

    # 3. Spezial-Handling für /main
    handle /main {
        reverse_proxy login-backend:8000 {
            header_up X-Forwarded-Proto {scheme}
            header_up Host {host}
        }
    }

    # 4. Django Backend Routen
    @django_backend path /api/* /admin/* /login /register /
    handle @django_backend {
        reverse_proxy login-backend:8000 {
            header_up X-Forwarded-Proto {scheme}
            header_up Host {host}
        }
    }

    # 5. Fallback für HTML
    try_files {path} {path}.html /start.html


    # Sicherheits-Header (Verhindert CSS-Blockaden durch Browser)
    header {
        X-Content-Type-Options nosniff
    }


# --- 2. MAILCOW (Subdomain) ---
    mail.aetherus.net {
    # Wir nutzen das Gateway deines Mailcow-Netzwerks (172.30.1.1)
        reverse_proxy 172.30.1.1:8080 {
            header_up Host {host}
            header_up X-Forwarded-Proto {scheme}
        
        # Wichtig für Mailcow-Websockets/ActiveSync
            header_up Upgrade {http.request.header.Upgrade}
            header_up Connection {http.request.header.Connection}
        }
    }
}