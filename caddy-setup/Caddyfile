# --- 1. HAUPTDOMAIN (Django & Frontend) ---
aetherus.net, www.aetherus.net {

    root * /usr/share/caddy/html
    

    handle_path /static/* {
        root * /app/staticfiles
        file_server
    }
    

    @backend path /api/* /admin/* /login /register /main /
    reverse_proxy @backend login-backend:8000


    try_files {path} {path}.html /index.html 
    file_server 
}

# --- 2. MAILCOW (Subdomain) ---
mail.aetherus.net {
    # HIER: Die Umleitungskorrektur kommt NACH dem reverse_proxy Block
    
    # 1. Standard Reverse Proxy (sendet Upstream Header)
    reverse_proxy nginx-mailcow:8080 {
        header_up Host {host}
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Host {host}
    }

    # 2. Downstream Header Modifikation (Korrigiert die Umleitung)
    # Fängt die fehlerhafte Umleitung ab und korrigiert den Hostnamen.
    # Wichtig: Diese Anweisung ist ein separater Handler und sollte *nach* dem proxy kommen.
    # WICHTIG: Die Replace-Syntax muss ohne Anführungszeichen sein, um Argumente zu trennen.
    header Location replace https://nginx-mailcow https://mail.aetherus.net
}