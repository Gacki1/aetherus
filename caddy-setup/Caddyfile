# --- 1. HAUPTDOMAIN (Django & Frontend) ---
aetherus.net, www.aetherus.net {

    root * /usr/share/caddy/html
    

    handle_path /static/* {
        root * /app/staticfiles
        file_server
    }
    

    @backend path /api/* /admin/* /login /register /main /
    reverse_proxy @backend login-backend:8000


    try_files {path} {path}.html /index.html 
    file_server 
}

# --- 2. MAILCOW (Subdomain) ---
mail.aetherus.net {
    reverse_proxy nginx-mailcow:8080 {
        # Alle Header-Anweisungen werden in den 'header' Block verschoben
        header {
            # Upstream Header (zu Mailcow)
            Host {host}
            X-Forwarded-Proto https
            X-Forwarded-For {remote_host}
            X-Forwarded-Host {host}

            # Downstream Header (von Mailcow zurück zum Browser)
            # Fängt die fehlerhafte Umleitung ab und korrigiert den Hostnamen.
            # WICHTIG: Die Argumente müssen durch Leerzeichen getrennt sein.
            Location replace "https://nginx-mailcow" "https://mail.aetherus.net"
        }
    }
}