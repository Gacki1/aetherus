aetherus.net {
    # --- 1. Statische Dateien ---
    handle_path /static/* {
        root * /app/staticfiles
        file_server
    }

    handle /assets/* {
        root * /usr/share/caddy/html
        file_server
    }

    # --- 2. HTML-Endungen entfernen ---
    @html_suffix path *.html
    redir @html_suffix {path.strip_suffix.html} permanent

    # --- 3. Django Backend & Pages ---
    handle /api/* {
        reverse_proxy login-backend:8000 {
            # WICHTIG: Damit Django merkt, dass HTTPS aktiv ist
            header_up X-Forwarded-Proto {scheme}
            header_up Host {host}
        }
    }
    
    handle /admin/* {
        reverse_proxy login-backend:8000 {
            header_up X-Forwarded-Proto {scheme}
            header_up Host {host}
        }
    }

    @django_pages path / /login /register /main
    handle @django_pages {
        reverse_proxy login-backend:8000 {
            header_up X-Forwarded-Proto {scheme}
            header_up Host {host}
        }
    }

    # --- 4. Fallback ---
    handle {
        root * /usr/share/caddy/html
        try_files {path} {path}/ =404
    }
}

# --- 5. Mailcow Setup ---
mail.aetherus.net {
    # Nutze hier die Gateway-IP deines Mailcow-Netzwerks
    reverse_proxy 172.30.1.1:8080 {
        header_up Host {host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# --- 6. WWW Redirect ---
www.aetherus.net {
    redir https://aetherus.net{uri}
}